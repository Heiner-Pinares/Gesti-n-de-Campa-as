VALIDATION_EXCLUDED_SPCODES=3674
VALIDATION_MAX_DAYS=31
VALIDATION_BATCH_SIZE=500
VALIDATION_TOLERANCE=0.01

# Rutas locales o del servidor Windows. Los archivos no se versionan.
