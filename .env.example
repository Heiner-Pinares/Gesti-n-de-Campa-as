DEBUG=False
SECRET_KEY=
# Solo para la primera prueba interna. Reemplace * por IP y nombre definitivos.
ALLOWED_HOSTS=*
HOST=0.0.0.0
PORT=8000
THREADS=8

DB_ENGINE=oracle
ORACLE_HOST=scan-odscbio
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ODSCBIO
ORACLE_USER=USRFACDOC[USRVALCBIO]
ORACLE_SCHEMA=USRVALCBIO
ORACLE_PASSWORD_FILE=secrets/oracle_password.txt
ORACLE_DSN=
ORACLE_POOL=false

# Nunca se habilita automáticamente. Cualquier migración requiere aprobación.
